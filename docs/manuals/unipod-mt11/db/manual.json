  "safety_notes": [
    {
      "id": 1,
      "level": "禁止",
      "text": "禁止使用思翼 ZT30/ZR30 减震快拆爪安装 MT11"
    },
    {
      "id": 2,
      "level": "禁止",
      "text": "禁止红外镜头对准太阳、熔岩、激光等强能量源"
    },
    {
      "id": 3,
      "level": "禁止",
      "text": "禁止超过工作电压范围供电"
    },
    {
      "id": 4,
      "level": "禁止",
      "text": "禁止擅自拆卸改装；禁止军事用途"
    },
    {
      "id": 5,
      "level": "注意",
      "text": "勿带电插拔 TF / 拆装吊舱"
    },
    {
      "id": 6,
      "level": "注意",
      "text": "关机后间隔 ≥30s 再重启"
    },
    {
      "id": 7,
      "level": "注意",
      "text": "供电设备应满足 5A 过流"
    },
    {
      "id": 8,
      "level": "注意",
      "text": "使用后放入防爆箱并放干燥剂"
    },
    {
      "id": 9,
      "level": "注意",
      "text": "ZT30/ZR30 用 MT11 快拆爪时起始方向与 MT11 相差 90°"
    },
    {
      "id": 10,
      "level": "危险",
      "text": "闲置远离儿童；避免 >60℃ 或 <-20℃"
    }
  ],
