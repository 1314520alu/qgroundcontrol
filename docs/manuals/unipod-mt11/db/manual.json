  "faq": [
    {
      "id": 1,
      "q_no": 1,
      "question": "广角镜头怎么打开？",
      "answer": "可见光下变倍 1–3.2 为广角，3.3–11 为变焦镜头。"
    },
    {
      "id": 2,
      "q_no": 2,
      "question": "主副码流能同时录制拍照吗？",
      "answer": "可以，在 UniGCS 里设置。"
    },
    {
      "id": 3,
      "q_no": 3,
      "question": "减震爪能装 ZT30/ZR30 镜头吗？",
      "answer": "可以；但 MT11 镜头本体不能装到 ZT30/ZR30 减震爪上。"
    },
    {
      "id": 4,
      "q_no": 4,
      "question": "官网固件为什么只有一个？",
      "answer": "整合了相机、变焦板、云台固件，升级一个即可。"
    },
    {
      "id": 5,
      "q_no": 5,
      "question": "有几种升级方式？",
      "answer": "1) UniGCS 一键升级；2) 固件放入内存卡插入吊舱升级。"
    },
    {
      "id": 6,
      "q_no": 6,
      "question": "热成像超分效果？",
      "answer": "2x 视频超分：640×512→1280×1024；照片超分可达 1280×1024 或 2560×2048。"
    },
    {
      "id": 7,
      "q_no": 7,
      "question": "镜头像素？",
      "answer": "有效像素 4800 万。"
    },
    {
      "id": 8,
      "q_no": 8,
      "question": "AI 能否用第三方数据？",
      "answer": "需用 UniAI Studio 训练后导入。"
    },
    {
      "id": 9,
      "q_no": 9,
      "question": "抗风数据？",
      "answer": "极限 140km/h、巡航 120km/h（实验室）。"
    },
    {
      "id": 10,
      "q_no": 10,
      "question": "支持哪些融合飞控固件？",
      "answer": "ArduPilot；部分闭源飞控。"
    },
    {
      "id": 11,
      "q_no": 11,
      "question": "是否适配其他链路出图？",
      "answer": "第三方支持 RTSP 拉流即可。"
    },
    {
      "id": 12,
      "q_no": 12,
      "question": "激光测距距离？",
      "answer": "5–1200 米。"
    },
    {
      "id": 13,
      "q_no": 13,
      "question": "适配场景？",
      "answer": "无人机、车、船、机器狗。"
    },
    {
      "id": 14,
      "q_no": 14,
      "question": "是否支持航测？",
      "answer": "可做基础航测。"
    },
    {
      "id": 15,
      "q_no": 15,
      "question": "是否支持二次开发？",
      "answer": "可以，参考官网 SDK。"
    },
    {
      "id": 16,
      "q_no": 16,
      "question": "AI 算力？",
      "answer": "10T。"
    },
    {
      "id": 17,
      "q_no": 17,
      "question": "横滚轴电机能控制吗？",
      "answer": "不可以。"
    },
    {
      "id": 18,
      "q_no": 18,
      "question": "支持什么协议控制？",
      "answer": "UDP/TCP、UART、S.BUS。"
    },
    {
      "id": 19,
      "q_no": 19,
      "question": "视频流协议？",
      "answer": "RTSP。"
    },
    {
      "id": 20,
      "q_no": 20,
      "question": "防护等级？",
      "answer": "IP54。"
    },
    {
      "id": 21,
      "q_no": 21,
      "question": "拉流地址？",
      "answer": "主：rtsp://192.168.144.25:8554/video1；副：.../video2。"
    },
    {
      "id": 22,
      "q_no": 22,
      "question": "可以更改 IP 吗？",
      "answer": "需连接 UniGCS 更改。"
    },
    {
      "id": 23,
      "q_no": 23,
      "question": "可转动角度？",
      "answer": "俯仰 -90°~-20°、航向 360°无限（FAQ 表述；手册技术参数俯仰为 -90°~20°）。"
    },
    {
      "id": 24,
      "q_no": 24,
      "question": "支持 HDMI 出图吗？",
      "answer": "不可以。"
    },
    {
      "id": 25,
      "q_no": 25,
      "question": "照片如何显示坐标？",
      "answer": "需连接飞控并配置对应参数。"
    },
    {
      "id": 26,
      "q_no": 26,
      "question": "S.BUS 无法控制？",
      "answer": "查线序、通道设置、确认 S.BUS 1.0。"
    },
    {
      "id": 27,
      "q_no": 27,
      "question": "支持大疆无人机吗？",
      "answer": "不支持。"
    },
    {
      "id": 28,
      "q_no": 28,
      "question": "热成像无法变倍？",
      "answer": "检查是否打开热成像联动变倍。"
    },
    {
      "id": 29,
      "q_no": 29,
      "question": "变倍>11 拍照仍是 11 倍？",
      "answer": "若打开 8K 拍照，上限 11 倍。"
    },
    {
      "id": 30,
      "q_no": 30,
      "question": "广角和变焦能分开拉流吗？",
      "answer": "不可以。"
    },
    {
      "id": 31,
      "q_no": 31,
      "question": "NETD？",
      "answer": "≤50mK@25℃，F#1.0。"
    },
    {
      "id": 32,
      "q_no": 32,
      "question": "内存卡类型？",
      "answer": "FAT32、exFAT。"
    },
    {
      "id": 33,
      "q_no": 33,
      "question": "改 IP 后忘记怎么办？",
      "answer": "UniGCS 扫描；或拉 rtsp://192.168.144.80:8554/video1 后复位。"
    },
    {
      "id": 34,
      "q_no": 34,
      "question": "录像编码？",
      "answer": "H.265。"
    }
  ],
